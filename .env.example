# ============================================================
# SaarlandBot Lite Edition – Konfiguration
# ============================================================
# 1. Kopiere diese Datei: cp .env.example .env
# 2. Ersetze ALLE Platzhalter mit deinen echten Werten.
# 3. Starte den Bot: docker compose up -d
#
# Vollversion mit allen Features: https://saarlandbot.de
# ============================================================

# ---- Discord Bot ----
# Erstelle einen Bot unter https://discord.com/developers/applications
DISCORD_TOKEN=DEIN_BOT_TOKEN_HIER
DISCORD_CLIENT_ID=DEINE_CLIENT_ID_HIER
DISCORD_CLIENT_SECRET=DEIN_CLIENT_SECRET_HIER

# ---- OAuth2 Callback ----
# Muss in den Discord Developer Portal OAuth2-Einstellungen eingetragen werden
# Beispiel: https://deine-domain.de/api/auth/callback
DISCORD_CALLBACK_URL=http://localhost:3001/api/auth/callback

# ---- Datenbank (PostgreSQL) ----
# Wird automatisch vom Docker Compose befüllt – nur ändern wenn nötig
DB_USER=bot_user
DB_PASSWORD=SICHERES_PASSWORT_HIER
DB_NAME=saarlandbot_lite
DATABASE_URL=postgresql://bot_user:SICHERES_PASSWORT_HIER@postgres:5432/saarlandbot_lite

# ---- Redis ----
# Wird automatisch vom Docker Compose befüllt – nur ändern wenn nötig
REDIS_PASSWORD=SICHERES_REDIS_PASSWORT_HIER
REDIS_URL=redis://:SICHERES_REDIS_PASSWORT_HIER@redis:6379

# ---- Backend ----
BACKEND_PORT=3001
# Generiere einen zufälligen 64-Zeichen Hex-String: openssl rand -hex 32
SESSION_SECRET=ZUFAELLIGER_64_ZEICHEN_HEX_STRING_HIER
NODE_ENV=production
LOG_LEVEL=info

# ---- Frontend ----
# URL unter der das Dashboard erreichbar ist
FRONTEND_URL=http://localhost
VITE_DISCORD_CLIENT_ID=DEINE_CLIENT_ID_HIER
